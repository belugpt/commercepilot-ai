# Copy to .env for reference; environment variables must be loaded by your shell.
COMMERCEPILOT_DB=commercepilot.db
COMMERCEPILOT_PLANNER=offline
# Optional model planning: set COMMERCEPILOT_PLANNER=openai, an account-supported
# Responses API model, and OPENAI_API_KEY through your shell/secret manager.
# COMMERCEPILOT_MODEL=
# OPENAI_API_KEY=
# Provider credentials are deliberately absent. No connector is enabled by default.
